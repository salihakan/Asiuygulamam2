<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Limb Icon Box -->
        <FrameLayout
            android:id="@+id/history_item_icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_limb_active">

            <ImageView
                android:id="@+id/history_item_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arm"
                app:tint="@color/primary"
                android:contentDescription="@string/target_limb_label" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/history_item_tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 Eylül 2026, Pazartesi"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_item_tv_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0,7 ünite • Sağ Kol"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Status Chip & Toggle -->
        <TextView
            android:id="@+id/history_item_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_done"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Yapıldı ✓"
            android:textColor="@color/on_success"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/history_item_btn_toggle"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/edit"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
