<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Pulsing Bell / Syringe Circle -->
    <FrameLayout
        android:id="@+id/alarm_icon_frame"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_badge_pending"
        android:backgroundTint="#1E293B">

        <ImageView
            android:id="@+id/alarm_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="Alarm"
            android:src="@drawable/ic_syringe"
            app:tint="#38BDF8" />
    </FrameLayout>

    <!-- Alarm Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.06"
        android:text="ENJEKSİYON VAKTİ!"
        android:textColor="#F8FAFC"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="22:00"
        android:textColor="#94A3B8"
        android:textSize="18sp" />

    <!-- Info Card: Dose and Target Limb -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Dose Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="UYGULANACAK DOZ"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alarm_tv_dose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0,7 ünite"
                        android:textColor="#38BDF8"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/alarm_iv_limb"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_badge_pending"
                    android:backgroundTint="#0F172A"
                    android:contentDescription="Uzuv"
                    android:padding="10dp"
                    android:src="@drawable/ic_arm"
                    app:tint="#38BDF8" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#334155" />

            <!-- Limb Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="HEDEF BÖLGE (ROTASYON)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarm_tv_limb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sağ Kol"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <!-- Complete / Done Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_btn_complete"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#10B981"
            android:text="✓ Enjeksiyonu Yaptım (Tamamla)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check"
            app:iconTint="#FFFFFF" />

        <!-- Snooze 5 Minutes Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_btn_snooze"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:text="⏰ 5 Dakika Ertele"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            app:cornerRadius="16dp" />

        <!-- Dismiss / Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_btn_dismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Alarmı Kapat"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
